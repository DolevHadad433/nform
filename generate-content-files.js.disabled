/**
 * DISABLED: This script generates placeholder content instead of real content
 * 
 * This script was creating "This is a placeholder content for {id}" content files
 * which were overriding the real rich content generated by webpack plugins from
 * the markdown files in apps/nform-demo-app/content/
 * 
 * The real content generation is handled by:
 * - MarkdownPagesWebpackPlugin
 * - PebulaDynamicDictionaryWebpackPlugin  
 * - MarkdownCodeExamplesWebpackPlugin
 * - MarkdownAppSearchWebpackPlugin
 * - ContentMappingFilesPlugin
 * 
 * Script to create all content files listed in pages.json but not yet created
 */
const fs = require('fs');
const path = require('path');
const mkdirp = require('mkdirp');

// Read the current pages.json
const pagesJsonPath = path.resolve(__dirname, 'dist/md-content/pages.json');
const pages = JSON.parse(fs.readFileSync(pagesJsonPath, 'utf8'));

// Extract all referenced files from entryData
const entryData = pages.entryData;

// Create a sample content template
const createContentTemplate = (id, title) => {
    return JSON.stringify({
        id,
        title,
        contents: `# ${title}\n\nThis is a placeholder content for ${id}.`
    }, null, 2);
};

console.log('Generating content files referenced in pages.json...');

// Process each file in entryData
Object.entries(entryData).forEach(([id, filePath]) => {
    const fullPath = path.resolve(__dirname, 'dist', filePath);
    const dirPath = path.dirname(fullPath);

    // Create directory if it doesn't exist
    if (!fs.existsSync(dirPath)) {
        console.log(`Creating directory: ${dirPath}`);
        mkdirp.sync(dirPath);
    }

    // Check if file exists, if not create it
    if (!fs.existsSync(fullPath)) {
        const title = getPageTitle(id, pages);
        const content = createContentTemplate(id, title);

        console.log(`Creating file: ${fullPath}`);
        fs.writeFileSync(fullPath, content);
    } else {
        console.log(`File already exists: ${fullPath}`);
    }
});

console.log('Content generation complete!');

// Helper function to get page title from the pages structure
function getPageTitle(id, pages) {
    // Handle root entry
    if (id === '/' && pages.entries['/']) {
        return pages.entries['/'].title;
    }

    // Handle top-level entries
    if (pages.entries[id]) {
        return pages.entries[id].title;
    }

    // Handle nested entries by traversing the structure
    let title = id;

    // This is a simple version that just returns the last part of the path
    // For a more robust solution, you'd want to traverse the entries tree
    const pathParts = id.split('/');
    return pathParts[pathParts.length - 1].split('-').map(word =>
        word.charAt(0).toUpperCase() + word.slice(1)
    ).join(' ');
}
